{
  "name": "pumpky",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@reactvision/react-viro": "3.0.3",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "three": "0.160.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/prepare-web.mjs && expo start --web",
    "build:web": "node scripts/prepare-web.mjs && expo export --platform web",
    "lint": "expo lint src components public/web-ar scripts",
    "typecheck": "tsc --noEmit",
    "test:install": "node scripts/check-install.mjs",
    "test:web": "node scripts/check-web.mjs",
    "test:fit": "node scripts/check-fit.mjs",
    "test:statue": "node scripts/check-statue-placement.mjs && node scripts/check-web.mjs --statue",
    "models:build": "node scripts/build-models.mjs",
    "models:previews": "node scripts/render-model-previews.mjs"
  },
  "overrides": {
    "@reactvision/react-viro": {
      "react": "$react"
    }
  },
  "private": true
}
